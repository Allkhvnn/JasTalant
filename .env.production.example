# Public application address. HTTPS is required for secure refresh cookies.
FRONTEND_URL=https://crm.example.kz
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# PostgreSQL
DB_NAME=jastalant
DB_USERNAME=jastalant
DB_PASSWORD=replace-with-a-long-random-password
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Generate with: openssl rand -base64 64
JWT_SECRET_BASE64=replace-with-a-base64-secret
AUTH_REFRESH_DAYS=30

# Use credentials issued by an SMTP provider. MAIL_FROM must be verified there.
MAIL_FROM=no-reply@example.kz
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_TEST_CONNECTION=true

# Optional: published GHCR images instead of local builds.
# BACKEND_IMAGE=ghcr.io/allkhvnn/jastalant-backend:latest
# FRONTEND_IMAGE=ghcr.io/allkhvnn/jastalant-frontend:latest
