# Local development only. Replace with your own password.
DB_PASSWORD=replace-with-local-password
# JWT_SECRET_BASE64 is required by the application. Generate at least 32 random bytes.
# Spring Boot does not read .env automatically; pass variables via the shell/IDE.
# Keep true behind HTTPS in production. The local Spring profile overrides it to false.
AUTH_REFRESH_COOKIE_SECURE=true
