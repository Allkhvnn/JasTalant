# Local development only. The local Spring profile and Docker Compose read this file.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/jastalant
DB_PASSWORD=replace-with-local-password
# Generate at least 32 random bytes and encode them as Base64.
JWT_SECRET_BASE64=replace-with-base64-secret
# The local Spring profile uses an insecure cookie so localhost works over HTTP.
AUTH_REFRESH_COOKIE_SECURE=false

# Real email via Gmail: run with --spring.profiles.active=local,smtp.
# Enable Google 2-Step Verification and generate an app password for JasTalant.
# Do not use your Google account password. Do not commit your actual .env.
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
# The smtp profile defaults to smtp.gmail.com:587, auth and required STARTTLS.
# MAIL_FROM defaults to SMTP_USERNAME. Override only with an authorized sender.
# MAIL_FROM=your-address@gmail.com
FRONTEND_URL=http://localhost:5173
# Optional overrides:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TEST_CONNECTION=true
